{
    "name": "website",
    "version": "1.5.3",
    "scripts": {
        "ng": "ng",
        "start": "ng serve",
        "build": "ng build",
        "postbuild": "node scripts/hash-i18n.mjs dist/website/browser/assets/i18n",
        "deploy": "ng build --base-href / && cp robots.txt dist/website/browser/",
        "watch": "ng build --watch --configuration development",
        "analyze": "ng build --stats-json && webpack-bundle-analyzer dist/website/stats.json",
        "test": "ng test",
        "lint": "eslint \"src/**/*.ts\" \"src/**/*.html\"",
        "lint:fix": "eslint \"src/**/*.ts\" \"src/**/*.html\" --fix"
    },
    "private": true,
    "dependencies": {
        "@angular/common": "^22.1.1",
        "@angular/compiler": "^22.1.1",
        "@angular/core": "^22.1.1",
        "@angular/forms": "^22.1.1",
        "@angular/platform-browser": "^22.1.1",
        "@angular/platform-browser-dynamic": "^22.1.1",
        "@angular/router": "^22.1.1",
        "@fortawesome/angular-fontawesome": "^5.1.0",
        "@fortawesome/fontawesome-svg-core": "^7.3.1",
        "@fortawesome/free-brands-svg-icons": "^7.3.1",
        "@fortawesome/free-regular-svg-icons": "^7.3.1",
        "@fortawesome/free-solid-svg-icons": "^7.3.1",
        "@ng-bootstrap/ng-bootstrap": "^21.0.0",
        "@ngx-translate/core": "^18.0.0",
        "@ngx-translate/http-loader": "^18.0.0",
        "bootstrap": "^5.3.3",
        "bootstrap-icons": "^1.10.5",
        "ngx-cookie-service": "^22.0.0",
        "rxjs": "~7.8.1",
        "tslib": "^2.3.0"
    },
    "devDependencies": {
        "@angular/build": "^22.1.3",
        "@angular/cli": "~22.1.3",
        "@angular/compiler-cli": "^22.1.1",
        "@eslint/eslintrc": "^3.3.1",
        "@eslint/js": "^10.0.1",
        "@ngx-builders/analyze": "^4.0.0",
        "@schematics/angular": "^22.1.3",
        "@stylistic/eslint-plugin": "^6.0.1",
        "@stylistic/eslint-plugin-ts": "^4.2.0",
        "@types/node": "^26.2.0",
        "@vitest/eslint-plugin": "^1.6.28",
        "angular-eslint": "22.8.0",
        "eslint": "^10.8.1",
        "eslint-config-prettier": "^10.1.2",
        "jsdom": "^31.0.1",
        "prettier": "^3.10.1",
        "typescript": "~6.0.3",
        "typescript-eslint": "^8.74.0",
        "vitest": "^5.1.1",
        "webpack-bundle-analyzer": "^5.3.1"
    }
}

{
    "name": "website",
    "version": "1.5.0",
    "scripts": {
        "ng": "ng",
        "start": "ng serve",
        "build": "ng build",
        "deploy": "ng build --base-href / && cp robots.txt dist/website/browser/",
        "watch": "ng build --watch --configuration development",
        "analyze": "ng build --stats-json && webpack-bundle-analyzer dist/website/stats.json",
        "test": "ng test",
        "lint": "ng lint",
        "lint:fix": "ng lint --fix"
    },
    "private": true,
